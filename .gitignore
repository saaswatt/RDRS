@'
# Python virtual environments
.venv/
venv/
env/

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Runtime databases
*.db
*.sqlite3

# Runtime logs
logs/*
!logs/.gitkeep

# Runtime data: databases, reports, sandbox and quarantine
data/*
!data/.gitkeep

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
'@ | Set-Content .\.gitignore -Encoding UTF8